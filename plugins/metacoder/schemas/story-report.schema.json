{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wcy/ai-plugins/main/plugins/metacoder/schemas/story-report.schema.json",
  "title": "Story report (mexecute wave agent)",
  "description": "The structured result a per-story wave agent returns to the mexecute orchestrator after implementing its story in an isolated worktree. Drives the barrier merge/salvage decision, retry accounting, and plan-state updates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["story_id", "repo", "run", "attempt", "status", "branch"],
  "properties": {
    "story_id": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}[a-z]?-[A-Za-z0-9._-]+$" },
    "repo": { "type": "string", "minLength": 1 },
    "run": { "type": "integer", "minimum": 1, "description": "The run this attempt belongs to (never 0 — an attempt always belongs to a started run)." },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3, "description": "The bound is per run." },
    "status": {
      "enum": ["applied", "failed"],
      "description": "applied = code written and Post-Story Validation passed; failed otherwise."
    },
    "branch": { "type": "string", "minLength": 1, "description": "The story's worktree branch, e.g. mexec/<plan-id>/<story-id>/r<run>/<attempt>." },
    "worktree": { "type": "string", "description": "Absolute worktree path (kept if failed/unmerged, for salvage)." },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "post_story": { "enum": ["pass", "fail", "not-run"] },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "result"],
            "properties": {
              "kind": { "enum": ["exit-code", "prose"] },
              "command": { "type": "string" },
              "exit_code": { "type": ["integer", "null"] },
              "description": { "type": "string" },
              "result": { "enum": ["pass", "fail"] }
            }
          }
        }
      }
    },
    "breaking_contract_change": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Set when an unanticipated breaking shared-interface change surfaced during implementation.",
      "properties": {
        "detected": { "const": true },
        "blast_radius": {
          "enum": ["contained", "significant"],
          "description": "contained = only breaks code in this story (defer to final report, run continues); significant = cascades to shared spec / other repos (halt-and-escalate)."
        },
        "detail": { "type": "string", "minLength": 1 }
      },
      "required": ["detected", "blast_radius", "detail"]
    },
    "notes": { "type": "string" }
  }
}
