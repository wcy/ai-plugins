{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wcy/ai-plugins/main/plugins/metacoder/schemas/catalog.schema.json",
  "title": "CATALOG.yaml",
  "description": "Spec catalog for a repo (context/<repo>/spec/CATALOG.yaml) or the shared contract layer (context/shared/spec/CATALOG.yaml). See STANDARD-SPEC.md.",
  "oneOf": [
    { "$ref": "#/$defs/repoCatalog" },
    { "$ref": "#/$defs/sharedCatalog" }
  ],
  "$defs": {
    "facet": {
      "enum": ["overview", "datamodel", "interface", "deps", "impl", "test"]
    },
    "sharedFacet": {
      "enum": ["overview", "datamodel", "interface"]
    },
    "layerName": {
      "type": "string",
      "pattern": "^L([0-9]+|S)-[a-z0-9-]+$",
      "description": "e.g. L0-foundation, L1-core, LS-shared"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "facet"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "facet": { "$ref": "#/$defs/facet" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Only on INTERFACE files. A module that exports nothing omits the key entirely rather than declaring an empty list, mirroring SHARED-INTERFACE.md's rule for the document-side Exports: trailer."
        }
      }
    },
    "sharedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "facet"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "facet": { "$ref": "#/$defs/sharedFacet" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exports": { "type": "array", "items": { "type": "string" } }
      }
    },
    "repoCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "repo", "layers", "modules"],
      "properties": {
        "version": { "const": 1 },
        "generated": { "type": "string" },
        "repo": { "type": "string", "minLength": 1 },
        "shared_interfaces": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "description": "Shared interface TAGs this repo produces/consumes; each must exist in the shared catalog."
        },
        "layers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/layerName" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modules"],
            "properties": {
              "modules": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9-]+$" } }
            }
          }
        },
        "modules": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Z0-9-]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "files"],
            "properties": {
              "layer": { "$ref": "#/$defs/layerName" },
              "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
              "requirements": {
                "type": "array",
                "items": { "type": "string", "pattern": "^(project:)?REQ-[0-9]{3,}(-[a-z0-9]+(-[a-z0-9]+){1,3})?$" },
                "description": "REQ-<NNN> entries (same-tier) or project:REQ-<NNN> (cross-cutting project-tier reference) this module satisfies."
              },
              "depth": {
                "enum": ["contract", "full"],
                "description": "How far this module has been described. contract asserts that OVERVIEW, DATAMODEL and INTERFACE exist and that the remaining facets are deliberately unwritten, so check catalog treats their absence as expected rather than as a missing file; full is every facet. Absent means full and is never defaulted into the document, so every catalog written before spec depth existed reads as fully described — which is what it is. The field can only narrow a module's claimed coverage, never silently widen it."
              }
            }
          }
        }
      }
    },
    "sharedCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scope", "interfaces"],
      "properties": {
        "version": { "const": 1 },
        "generated": { "type": "string" },
        "scope": { "const": "shared" },
        "interfaces": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Z0-9-]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["files"],
            "properties": {
              "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sharedFile" } },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "description": "The agreement version consuming work records itself against. Absent means 1. Only an mspec cascade bumps it, and nothing ever lowers it."
              }
            }
          }
        }
      }
    }
  }
}
